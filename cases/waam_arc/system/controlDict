FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     beamWeldFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1e-06;

deltaT          1.0e-7;

writeControl    adjustableRunTime;

writeInterval   1e-07;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.1;

maxAlphaCo      0.1;

maxDeltaT       1.0e-5;


// ************************************************************************* //
