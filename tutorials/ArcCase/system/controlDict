FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     beamWeldFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// One pass over the 8 mm domain at 500 mm/min = 0.96 s of travel
endTime         1.0;

deltaT          5.0e-7;

writeControl    adjustableRunTime;

writeInterval   0.01;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;//0.1;

maxAlphaCo      0.25;

maxDeltaT       5.0e-6;     // cap: above ~1e-5 s the epsilon1/temperature
                            // corrector falls into a 0<->1 limit cycle
                            // (max residual stuck at 1.0) and the run dies
minDeltaT       10e-8;

functions
{
    // Peak temperature in the domain [K]
    temperatureMax
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       max;
        fields          (Temperature);
        writeControl    timeStep;
        writeInterval   100;
        executeControl  timeStep;
        executeInterval 100;
        writeFields     false;
        log             false;
    }

    // Melted metal volume [m3]: epsilon1 (liquid fraction) weighted by
    // alpha.phase1, because in the gas phase epsilon1 is identically 1
    // (phase2 Tsolidus 1 / Tliquidus 10)
    meltVolume
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       weightedVolIntegrate;
        fields          (epsilon1);
        weightField     alpha.phase1;
        writeControl    timeStep;
        writeInterval   100;
        executeControl  timeStep;
        executeInterval 100;
        writeFields     false;
        log             false;
    }

    // Total metal volume [m3]: constant (no mass sources), conservation check
    metalVolume
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       volIntegrate;
        fields          (alpha.phase1);
        writeControl    timeStep;
        writeInterval   100;
        executeControl  timeStep;
        executeInterval 100;
        writeFields     false;
        log             false;
    }

    // History probes: arc-side (top) surface, mid-thickness, back surface,
    // gas above the plate, and the arc start point.
    // Plate occupies y = 1..3 mm; arc impinges on y = 1 mm face and travels
    // towards +z; probe at z = -3.75 mm is reached at t = 0.03 s.
    temperatureProbes
    {
        type            probes;
        libs            (sampling);
        fields          (Temperature epsilon1);
        probeLocations
        (
            (0 0.0010333 -0.00375) // plate top (arc side)
            (0 0.0020000 -0.00375) // plate mid-thickness
            (0 0.0029667 -0.00375) // plate bottom (back side)
            (0 0.0009667 -0.00375) // gas gap above the plate
            (0 0.0010333 -0.00400) // arc start point, plate top
        );
        fixedLocations  true;
        executeControl  timeStep;
        executeInterval 100;
        writeControl    timeStep;
        writeInterval   100;
    }

    // Cell centres (Cx, Cy, Cz) for the post-processing script
    cellCentres
    {
        type            writeCellCentres;
        libs            (fieldFunctionObjects);
        executeControl  onEnd;
        writeControl    onEnd;
    }
}


