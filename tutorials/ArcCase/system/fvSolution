FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.phase1.*"
    {
        nAlphaCorr      3;
        nAlphaSubCycles 3;
        cAlpha          1.0;    // sharp interface: 0.5 gave a diffuse
                               // interface with a steady MULES clipping leak
	scAlpha		0.0;    // no extra shear compression (test): it may tear
                               // droplets off the pool under Marangoni shear

        MULESCorr       yes;
        nLimiterIter    5;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0;
    }

    p_rgh
    {
        solver          GAMG;
        tolerance       1e-9;
        relTol          0.0;//0.005;//0.05;
        smoother        GaussSeidel;//GaussSeidel;//
        nPreSweeps      2;
        nPostSweeps     3;
        nFinestSweeps   2;
        cacheAgglomeration on;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    p_rghFinal
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       1e-9;
            relTol          0;
            nVcycles        5;
            smoother        GaussSeidel;//GaussSeidel;//DICGaussSeidel;//
            nPreSweeps      2;
            nPostSweeps     3;
            nFinestSweeps   2;
            cacheAgglomeration on;
            nCellsInCoarsestLevel 10;
            agglomerator    faceAreaPair;
            mergeLevels     1;
        }
        tolerance       1e-9;
        relTol          0;
        maxIter         25;//20;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       1e-9;
            relTol          0;
            smoother        GaussSeidel;
        }
        tolerance       1e-9;
        relTol          0;
        maxIter         100;
    }

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;//GaussSeidel;//DICGaussSeidel;//
        tolerance       1e-9;
        relTol          0.0;//0.1;
        nSweeps         5;//1;
    }

    UFinal
    {
        $U;
        tolerance       1e-9;
        relTol          0;
    }

    Temperature
    {
/*
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-12;
        minIter         1;
        maxIter         500;//2
*/
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.0;
    }

    TemperatureFinal
    {
        $Temperature;
    }
}

PIMPLE
{
    nOuterCorrectors 2;     // 2 outer iterations for the stiff
                            // Marangoni/recoil coupling (was 1)
    nCorrectors     3;
    nNonOrthogonalCorrectors 0;
    pRefCell        0.0;
    pRefValue       0.0;
}

MELTING
{
    minTempCorrector 1;
    maxTempCorrector 150;
    epsilonTolerance 1e-6;
    epsilonRelaxation 0.5;    // halved: the 0<->1 limit cycle that killed
                              // the run at ~0.51 s (same converged result)

    // Arc process parameters (GMAW on SS308L):
    //   current 151 A, arc voltage 19.7 V, arc efficiency 0.8
    //   -> HS_Q = 151 * 19.7 * 0.8 = 2379.76 W delivered to the workpiece
    //   travel speed 500 mm/min = 8.3333e-3 m/s
    //   wire feed 6 m/min (not modelled: beamWeldFoam has no filler-wire
    //   mass source, so deposited filler metal is not added)
    //
    //	//	Heatsource characteristics
    HS_a 0.002;             // arc spot radius [m]
    HS_bg 0.0;              // spot offset in x [m]
    HS_velocity 8.3333e-3;  // 500 mm/min travel speed [m/s]
    HS_lg -0.004;           // start at z = -4 mm, travel towards +z [m]
    HS_Q 2379.76;           //151 A * 19.7 V * 0.8 efficiency [W]

    HS_deposition_cutoff 0.99;  // conduction mode (author's note): rays
                                // ignore smeared/flotsam cells and deposit
                                // on the dense pool surface

    Oscillation_Amplitude   0.0;//0.015;
    Oscillation_Frequency   0.0;

    Y_R 0.2;//0.05; //Y_R->0 HS -> wider
    focY	0.0165;  //-0.08;//
    foc_shift_vel 0.0;
    Q_ramp_rate 0.0;    // no ramp-down: full arc power for the whole pass
    tshift 0.0;

    damperSwitch true;    // partition interface forces/sinks by density:
                            // with the 7900:1 metal/gas ratio the explicit
                            // evaporative sink would otherwise drive the
                            // low-heat-capacity gas cells to negative T

    recoilScale 0.2;        // apply 20% of the equilibrium vapour recoil:
                            // the full 0.54*p0 digs an unphysical trench
                            // under a 2.4 kW arc (Qv cooling untouched)
}

relaxationFactors
{
    "U.*"           0.82;//0.82;//1;
}

